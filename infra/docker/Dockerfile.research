# ULTRONE Research Platform Dockerfile
# Multi-stage build for the autonomous research platform

FROM python:3.11-slim as base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Set Python path
# Monorepo: packages keep their original import names but live in buckets
# (see _ultrone_paths.py); expose every bucket so imports resolve in-container.
ENV PYTHONPATH=/app:/app/apps:/app/packages/core:/app/packages/cognition:/app/packages/agents:/app/packages/knowledge:/app/packages/orchestration:/app/packages/runtime:/app/packages/safety:/app/packages/observability:/app/packages/transport:/app/research:/app/simulation:/app/vendor:/app/data
ENV PYTHONUNBUFFERED=1

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "from knowledge_engine import KnowledgeMemoryManager; print('healthy')" || exit 1

# Default command: run the research platform API.
# NOTE: no ENTRYPOINT is set on purpose. An ENTRYPOINT of ["python"] would be
# prepended to every `docker run ... <args>` invocation, turning the CI smoke
# test's `python -c ...` into `python python -c ...` (and this CMD into
# `python python -m uvicorn ...`). The app module is ultron.server:app -- the
# documented, tested FastAPI app (see docs/ultron and tests/test_server.py).
# Like upstream Ultron, serving traffic needs the documented runtime embedding
# backend (dashscope/openai/local + API keys); the image build and the CI
# knowledge_engine smoke test do not.
CMD ["python", "-m", "uvicorn", "ultron.server:app", "--host", "0.0.0.0", "--port", "8000"]
